#!/usr/bin/env bash
# Snellius-only filesystem mapping. Source this file from Snellius wrappers.
# Do not add Leonardo paths here.

export REPO_DIR="/home/geusdd/VLM-3R"

# Verified project link: /projects/einf2748 -> /gpfs/work1/0/einf2748.
# The destination currently cannot be created because the project's inode
# quota is exhausted; retain this mapping and create it after that is fixed.
export VLM3R_ROOT="/scratch-shared/geusdd/VLM3R"

export MODEL_ROOT="$VLM3R_ROOT/models"
export LOCAL_MODEL_BASE="$MODEL_ROOT/LLaVA-NeXT-Video-7B-Qwen2"
export LOCAL_SIGLIP="$MODEL_ROOT/siglip-so400m-patch14-384"

export DATA_ROOT="$VLM3R_ROOT/data/vlm3r"
export VSI_BENCH_DATA_ROOT="$DATA_ROOT/VLM-3R-DATA"
export VSI_BENCH_TRAIN_ROOT="$VSI_BENCH_DATA_ROOT/vsibench_train"
# The current training wrapper supplies DATA_ROOT as --image_folder. The JSON
# files determine their exact relative media paths after migration.
export VSI_BENCH_MEDIA_ROOT="$DATA_ROOT"

export CUT3R_FEATURE_ROOT="$VLM3R_ROOT/spatial_features/cut3r"
export CUT3R_DEC6_ROOT="$CUT3R_FEATURE_ROOT/dec6"
export CUT3R_DEC9_ROOT="$CUT3R_FEATURE_ROOT/dec9"
export CUT3R_DEC12_ROOT="$CUT3R_FEATURE_ROOT/dec12"

export TRAIN_SAVE_ROOT="$VLM3R_ROOT/checkpoints"

export HF_HOME="$VLM3R_ROOT/hf_cache"
export HF_DATASETS_CACHE="$HF_HOME/datasets"
export HUGGINGFACE_HUB_CACHE="$HF_HOME/hub"
export VSI_BENCH_EVAL_ROOT="$VLM3R_ROOT/data/vsibench"
export VSI_BENCH_EVAL_MEDIA_ROOT="$HF_HOME/vsibench"

export VLM3R_LOG_ROOT="$VLM3R_ROOT/logs"
export VLM3R_MANIFEST_ROOT="$VLM3R_ROOT/manifests"
export VLM3R_MIGRATION_ROOT="$VLM3R_ROOT/migration"

# Current CUT3R wrapper default. This belongs with the migrated repository,
# rather than a Leonardo binary or a copied shared object.
export CUT3R_WEIGHTS_PATH="$REPO_DIR/third_party/CUT3R/src/cut3r_512_dpt_4_64.pth"

# Runtime/build caches must avoid the inode-exhausted project space.
export XDG_CACHE_HOME="$VLM3R_ROOT/xdg_cache"
export TRITON_CACHE_DIR="$VLM3R_ROOT/triton_cache"
export TORCH_EXTENSIONS_DIR="$VLM3R_ROOT/torch_extensions"
